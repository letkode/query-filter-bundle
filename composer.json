{
    "name": "letkode/query-filter-bundle",
    "description": "Query, filter and pagination DTOs for Symfony applications",
    "type": "symfony-bundle",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "letkode/http-exception-bundle": "^1.2",
        "symfony/config": "^7.0 || ^8.0",
        "symfony/dependency-injection": "^7.0 || ^8.0",
        "symfony/http-kernel": "^7.0 || ^8.0",
        "symfony/translation-contracts": "^3.0",
        "symfony/validator": "^7.0 || ^8.0",
        "symfony/yaml": "^7.0 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11",
        "phpstan/phpstan": "^2",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "autoload": {
        "psr-4": {
            "Letkode\\QueryFilterBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Letkode\\QueryFilterBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "symfony": {
            "bundles": {
                "Letkode\\QueryFilterBundle\\LetkodeQueryFilterBundle": ["all"]
            }
        }
    }
}
